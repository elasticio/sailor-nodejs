{
    "name": "elasticio-sailor-nodejs",
    "description": "The official elastic.io library for bootstrapping and executing for Node.js connectors",
    "version": "3.0.0-ts-rewrite-dev1",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "audit": "better-npm-audit audit --level high --production",
        "lint": "eslint .",
        "test": "npm run build && npm run lint && npm run test:unit && npm run test:integration",
        "postpublish": "node scripts/postpublish.ts",
        "dev:local": "sh -c 'node scripts/run-local.ts \"$@\" | bunyan' --",
        "encode": "node scripts/encode-decode.ts encode",
        "decode": "node scripts/encode-decode.ts decode",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
        "test:unit": "NODE_ENV=test mocha \"test/unit/**/*.spec.ts\"",
        "test:integration": "NODE_ENV=test mocha \"test/integration/**/*.spec.ts\"",
        "test:coverage": "NODE_ENV=test c8 mocha \"test/unit/**/*.spec.ts\"",
        "prepublishOnly": "npm run build"
    },
    "engines": {
        "node": ">=24.22.1"
    },
    "dependencies": {
        "@elastic.io/maester-client": "6.0.3",
        "bunyan": "1.8.10",
        "elasticio-rest-node": "2.0.0",
        "jsonwebtoken": "9.0.3",
        "p-throttle": "8.1.1"
    },
    "devDependencies": {
        "@eslint/js": "9.39.5",
        "@types/bunyan": "1.8.11",
        "@types/chai": "5.2.3",
        "@types/chai-as-promised": "8.0.2",
        "@types/express": "5.0.6",
        "@types/jsonwebtoken": "9.0.10",
        "@types/mocha": "10.0.10",
        "@types/node": "24.19.2",
        "@types/sinon": "22.0.2",
        "@types/sinon-chai": "4.0.1",
        "better-npm-audit": "3.11.0",
        "c8": "10.1.3",
        "chai": "5.3.3",
        "chai-as-promised": "8.0.2",
        "eslint": "9.39.5",
        "express": "5.3.0",
        "globals": "17.13.0",
        "mocha": "11.8.0",
        "nock": "13.5.6",
        "request": "2.88.0",
        "request-promise-native": "1.0.5",
        "sinon": "22.1.0",
        "sinon-chai": "4.0.1",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.1"
    },
    "repository": "elasticio/sailor-nodejs",
    "license": "Apache-2.0",
    "type": "module",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "run.js",
        "runService.js"
    ]
}
